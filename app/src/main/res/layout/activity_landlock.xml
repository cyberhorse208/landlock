<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true"
    tools:context=".LandlockActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Version -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_landlock_version"
            android:textAppearance="@style/NativeTest.SectionLabel"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/NativeTest.CardView"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_landlock_getversion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_query_version" />

                <TextView
                    android:id="@+id/tv_landlock_version_output"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:text="" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Network rules -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_network_rules"
            android:textAppearance="@style/NativeTest.SectionLabel"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/NativeTest.CardView"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <EditText
                        android:id="@+id/landlock_listen_port_allowed"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/hint_listen_port_allowed"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <EditText
                        android:id="@+id/landlock_connect_port_allowed"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/hint_connect_port_allowed"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <EditText
                        android:id="@+id/landlock_listen_port_try"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/hint_listen_port_try"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <EditText
                        android:id="@+id/landlock_listen_timeout"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/hint_timeout_ms"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <EditText
                        android:id="@+id/landlock_connect_ip_try"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/hint_connect_ip_try"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <EditText
                        android:id="@+id/landlock_connect_port_try"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/hint_connect_port_try"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <EditText
                        android:id="@+id/landlock_connect_timeout"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/hint_timeout_ms"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_landlock_web_in_new_thread"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_net_op_new_thread" />

                    <RadioGroup
                        android:id="@+id/radio_group2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="6dp"
                        android:checkedButton="@+id/radio_btn_disable">

                        <RadioButton
                            android:id="@+id/radio_btn_enable2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_enable_ll" />

                        <RadioButton
                            android:id="@+id/radio_btn_disable2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_disable_ll" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- File test -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_file_rw_test"
            android:textAppearance="@style/NativeTest.SectionLabel"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/NativeTest.CardView"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_read_file"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/ed_landlock_read_filename_try"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/hint_file_path"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_write_file"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                    <EditText
                        android:id="@+id/ed_landlock_write_filename_try"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/hint_file_path"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_landlock_write_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_write" />

                    <EditText
                        android:id="@+id/landlock_input_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/hint_write_content"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- File rules -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_file_rules"
            android:textAppearance="@style/NativeTest.SectionLabel"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/NativeTest.CardView"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/landlock_RO_path_allowed"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="@string/hint_ro_path"
                    android:textSize="12sp"
                    android:inputType="text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/landlock_RW_path_allowed"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="@string/hint_rw_path"
                    android:textSize="12sp"
                    android:inputType="text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_landlock_file_in_new_thread"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_file_rw_new_thread" />

                    <RadioGroup
                        android:id="@+id/radio_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="6dp"
                        android:checkedButton="@+id/radio_btn_disable">

                        <RadioButton
                            android:id="@+id/radio_btn_enable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_enable_ll" />

                        <RadioButton
                            android:id="@+id/radio_btn_disable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_disable_ll" />
                    </RadioGroup>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_landlock_file_in_main_thread"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_file_rw_main_thread"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Output -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_output"
            android:textAppearance="@style/NativeTest.SectionLabel"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/landlock_text_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:background="@drawable/bg_output_rounded"
            android:padding="8dp"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:text="" />

    </LinearLayout>
</ScrollView>
